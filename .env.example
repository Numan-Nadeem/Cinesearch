# Server-only API keys (never prefixed with VITE_ so Vite never bundles them into client assets)
# Obtain a free OMDb API key at: https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=

# Optional TMDB API key for rich discovery, trending, genres, cast, and trailers
# Obtain a free TMDB API key at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Comma-separated list of allowed CORS origins for serverless functions
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8888,https://cinesearchpk.netlify.app

# Client-side active data provider flag: "omdb" (default) or "tmdb"
VITE_DATA_PROVIDER=omdb
